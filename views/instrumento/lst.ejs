
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Lista de Instrumentos</title>
</head>
<body>

    <h1>Instrumentos Musicais Cadastrados</h1>

    <a href="/instrumento/add">Cadastrar novo instrumento</a>

    <br><br>

    <table border="1" cellpadding="10">
        <tr>
            <th>Nome</th>
            <th>Fabricante</th>
            <th>Preço</th>
            <th>Tipo</th>
        </tr>

        <% instrumentos.forEach(instrumento => { %>
            <tr>
                <td><%= instrumento.nome %></td>
                <td><%= instrumento.fabricante %></td>
                <td>R$ <%= Number(instrumento.preco).toFixed(2) %></td>
                <td><%= instrumento.tipo %></td>
            </tr>
        <% }) %>

    </table>

</body>
</html>
