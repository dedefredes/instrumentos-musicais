<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastrar Instrumento</title>
</head>
<body>

    <h1>Cadastro de Instrumentos Musicais</h1>

    <form action="/instrumento/add" method="POST">

        <label>Nome:</label><br>
        <input type="text" name="nome" required><br><br>

        <label>Fabricante:</label><br>
        <input type="text" name="fabricante" required><br><br>

        <label>Preço:</label><br>
        <input type="number" name="preco" step="0.01" required><br><br>

        <label>Tipo:</label><br>
        <input type="text" name="tipo" required><br><br>

        <button type="submit">Cadastrar</button>

    </form>

    <br>
    <a href="/instrumento">Voltar para listagem</a>

</body>
</html>